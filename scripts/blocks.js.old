// blocks.js
function msg(id, def) {
    return Core.bundle.get(id) || def;
} //1440
function setWeather(weatherName, enable, time, fadeTime) {
    if (typeof Weathers === "undefined") {
        print("[More-Extended] Error: 'Weathers' is undefined.");
        return;
    }

    const targetWeather = Weathers[weatherName];
    if (!targetWeather) {
        print("[More-Extended] Error: '" + weatherName + "' weather is undefined.");
        return;
    }

    if (
        typeof targetWeather.isActive !== "function" ||
        typeof targetWeather.instance !== "function"
    ) {
        print(
            "[More-Extended] Error: Weather '" +
                weatherName +
                "' doesn't have isActive and instance method.",
        );
        return;
    }

    const isCurrentlyActive = targetWeather.isActive();

    if (enable) {
        if (!isCurrentlyActive) {
            Tmp.v1.setToRandomDirection();
            Call.createWeather(targetWeather, 1, time, Tmp.v1.x, Tmp.v1.y);
        } else {
            const currentLife = targetWeather.instance().life;
            targetWeather.instance().life = /*WeatherState.fadeTime*/ time;
        }
    } else {
        if (!isCurrentlyActive) {
            return;
        }
        const instance = targetWeather.instance();
        if (instance.life > /*WeatherState.fadeTime*/ fadeTime) {
            instance.life = /*WeatherState.fadeTime*/ fadeTime;
        }
    }
}
function showMenu() {
    const list = Object.keys(Weathers).filter((key) => Weathers[key] instanceof Weather);
    let time = Infinity;
    //print(time);
    const dis = () => {
        list.forEach((key) => {
            setWeather(key, false, time, 0);
        });
    };
    const get = (key) => Weathers[key].isActive() && Weathers[key].instance().life > 0;
    const getTime = (key) => {
        const inst = Weathers[key].instance();
        if (!inst) return 0;
        const life = inst.life;
        return isFinite(life) ? parseInt(life) : life;
    };
    const weatherName = (key) => msg("weather." + Weathers[key].name + ".name", key);
    const cur = () =>
        list
            .filter((key) => get(key))
            .map((key) => weatherName(key))
            .join(",");
    const buttons = {};
    const dialog = new Dialog();
    dialog.title.setText(msg("block.more-extended-weather-controller.name"));
    const cont = dialog.cont;
    /*cont.pad(10);
    cont.add("请选择天气：");
    cont.row();*/
    const curLabel = cont.add("").center().padBottom(10).color(Color.yellow);

    cont.row();
    const timeTable = new Table().center();
    timeTable.add(msg("message.more-extended-life-time") + ": ").center();
    timeTable
        .field(msg("message.more-extended-life-time"), (str) => {
            //print(str);
            time = parseFloat(str) || Infinity;
        })
        .center()
        .get()
        .setText("Infinity");
    cont.add(timeTable);
    cont.row();
    const pane = new ScrollPane(new Table());
    const table = pane.getWidget();
    table.center();
    const reflush = () => {
        curLabel
            .get()
            .setText(msg("message.more-extended-weather-current") + " :" + (cur() || msg("none")));
        list.forEach((key) => {
            buttons[key]
                .get()
                .setText(
                    (get(key) ? "[yellow]" : "[white]") +
                        weatherName(key) +
                        " " +
                        msg("message.more-extended-life-time") +
                        ": " +
                        getTime(key),
                );
        });
    };
    list.forEach((key) => {
        buttons[key] = table
            .button("", () => {
                //print(time);
                setWeather(key, !get(key), time, 0);
                reflush();
            })
            .center()
            .padBottom(5)
            .width(400)
            .height(50);
        table.row();
    });
    cont.add(pane).fillX().padBottom(10);
    cont.row();
    const bottomTable = new Table();
    bottomTable
        .button(msg("message.more-extended-all-off"), () => {
            dis();
            reflush();
        })
        .size(100, 40)
        .center();
    bottomTable
        .button(msg("message.more-extended-all-on"), () => {
            list.forEach((key) => setWeather(key, true, time, 0));
            reflush();
        })
        .size(100, 40)
        .center();
    bottomTable
        .button(msg("message.more-extended-reverse"), () => {
            list.forEach((key) => setWeather(key, !get(key), time, 0));
            reflush();
        })
        .size(100, 40)
        .center();
    cont.add(bottomTable).fillX();
    dialog.buttons
        .button(msg("close"), () => {
            dialog.hide();
        })
        .center();
    reflush();
    dialog.show();
}
function setBuilding(blockType, buildingCreator) {
    blockType.buildType = prov(() => buildingCreator(blockType));
}
setBuilding(extend(Block, "weather-controller", {}), (block) =>
    extend(Building, {
        buildConfiguration(table) {
            table
                .button(
                    Icon.upOpen,
                    Styles.cleari,
                    run(() => {
                        this.configure(0);
                    }),
                )
                .size(50)
                .tooltip(msg("message.more-extended-open-menu"));
        },
        configured(player, value) {
            switch (value) {
                case 0: {
                    showMenu();
                    break;
                }
                default: {
                    // print('Unknown config event value ' + value);
                }
            }
        },
    }),
);
setBuilding(
    extend(LiquidRouter, "water-collector", {
        /*hasLiquids: true,
        liquidCapacity: 500,
        size: 2,*/
    }),
    (block) =>
        extend(Building, {
            updateTile() {
                const get = (key) => Weathers[key].isActive() && Weathers[key].instance().life > 0;
                let outputAmount = 0.01;

                if (get("rain")) {
                    outputAmount = 1.0;
                } else if (get("snow")) {
                    outputAmount = 0.8;
                }

                this.liquids.add(Liquids.water, outputAmount);
                this.dumpLiquid(this.liquids.current());
            },
        }),
);
Events.on(ContentInitEvent, () => {
    try {
        const get = (type, id) => Vars.content.getByName(type, id);
        const block = (id) => Vars.content.block(id);
        const item = (id) => Vars.content.item(id);
        const liquid = (id) => Vars.content.liquid(id);
        const unit = (id) => Vars.content.unit(id);
        const planet = (id) => Vars.content.planet(id);

        block("more-extended-clay-water").set(block("water"), block("more-extended-clay-floor"));
        Vars.content.blocks().forEach((e) => {
            if (e.shownPlanets.get(planet("serpulo")) || e.shownPlanets.get(planet("erekir")))
                e.shownPlanets.add(planet("more-extended-veridia"));
        });
        Vars.content.items().forEach((e) => {
            if (e.shownPlanets.get(planet("serpulo")) || e.shownPlanets.get(planet("erekir")))
                e.shownPlanets.add(planet("more-extended-veridia"));
        });
        Vars.content.liquids().forEach((e) => {
            if (e.shownPlanets.get(planet("serpulo")) || e.shownPlanets.get(planet("erekir")))
                e.shownPlanets.add(planet("more-extended-veridia"));
        });
        Vars.content.units().forEach((e) => {
            if (e.shownPlanets.get(planet("serpulo")) || e.shownPlanets.get(planet("erekir")))
                e.shownPlanets.add(planet("more-extended-veridia"));
        });
    } catch (e) {
        print(e);
    }
});
